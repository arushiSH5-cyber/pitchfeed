# Leave any key empty to run that integration in demo mode. GET /health shows which is which.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
TAVILY_API_KEY=
HUNTER_API_KEY=
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io/v1
FLEXPRICE_CUSTOMER_ID=pitchfeed-demo-org
SENDGRID_API_KEY=
# All "sends" go here, never to real prospects.
DEMO_INBOX=you+pitchfeed@example.com
# Set to 6 before recording to show the credit gate on camera.
DEMO_CREDITS=400
GRAPH_DB_PATH=./data/graph.kuzu
