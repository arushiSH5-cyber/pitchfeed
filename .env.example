# Pitchfeed runs end to end with every key empty (demo mode).
# Fill a key to switch that integration to live. GET /api/health shows which is which.

# --- web (Next.js, /web) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Used when no Claude key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io/v1
FLEXPRICE_CUSTOMER_ID=pitchfeed-demo-org
# Point the web app at the FastAPI engine to proxy discovery (optional).
ENGINE_URL=

# --- engine (FastAPI, /engine) — see engine/.env.example for the full list ---
TAVILY_API_KEY=
HUNTER_API_KEY=
SENDGRID_API_KEY=
DEMO_INBOX=you+pitchfeed@example.com
DEMO_CREDITS=400
GRAPH_DB_PATH=./data/graph.kuzu
